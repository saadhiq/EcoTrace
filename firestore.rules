rules_version = '2';

// Clients may only READ their own data. All writes go through the backend
// (the Admin SDK bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Residents read their own household, bags and pickups. Queries must be
    // constrained to ownerUid / residentUid == the caller's uid.
    match /households/{householdId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;

      // Insights the resident listens to live. The household id IS the owner's
      // uid, so no extra document read is needed. Tips cache and consent
      // history stay API-only (covered by the deny-all rule below).
      match /stats/{doc} {
        allow read: if signedIn() && request.auth.uid == householdId;
        allow write: if false;
      }
      match /pointsLedger/{entryId} {
        allow read: if signedIn() && request.auth.uid == householdId;
        allow write: if false;
      }
    }

    match /bags/{code} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    match /pickups/{pickupId} {
      allow read: if signedIn() && resource.data.residentUid == request.auth.uid;
      allow write: if false;
    }

    // Collectors read their own route mirror (code-free) for a live "My route".
    // Requested pickups come only through the API.
    match /routes/{pickupId} {
      allow read: if signedIn() && resource.data.collectorUid == request.auth.uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
