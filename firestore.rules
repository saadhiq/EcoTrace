rules_version = '2';

// Clients may only read their own users/{uid} profile.
// All writes go through the backend (Admin SDK bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
