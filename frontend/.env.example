# Copy to .env.local for local development. Never commit .env files.
# All values are baked in at build time. scripts/deploy-frontend.sh fills them
# automatically for production (Cloud Run URL + `firebase apps:sdkconfig`).

# Base URL of the backend API (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Firebase web app config (Firebase console > Project settings > Your apps).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ecotrace-9e406.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ecotrace-9e406
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
